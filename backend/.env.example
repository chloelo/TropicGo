# 本機開發用（npm run dev），連到 docker compose 開的 PostgreSQL（localhost:5432）。
# 正式環境另外設定 NODE_ENV=production：JWT_SECRET 至少 32 字元、一定要指定 CORS_ORIGINS
PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=student
DB_PASSWORD=student666
DB_DATABASE=tropicgo
DB_SYNCHRONIZE=true
DB_ENABLE_SSL=false

JWT_SECRET=devsecret-change-me
JWT_EXPIRES_DAY=1d

# 允許呼叫 API 的前端網域，多個用逗號分隔
CORS_ORIGINS=http://localhost:5173

